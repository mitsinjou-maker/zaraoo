# Copiez ce fichier en « .env.local » et remplissez-le avec la configuration web de votre projet Firebase
# (console Firebase › Paramètres du projet › Vos applications › SDK Firebase › Configuration).
# Sans ce fichier, l'application fonctionne en mode local : les données restent dans le navigateur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
