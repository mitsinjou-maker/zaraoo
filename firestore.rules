rules_version = '2';

// Partage JIRAMA — chaque admin ne voit que ses propres données.
// - utilisateurs/{uid}/brouillon/courant : cycle en cours de saisie (lecture et écriture libres pour l'admin) ;
// - utilisateurs/{uid}/cycles/{id}       : cycles validés, figés (création seulement, jamais de modification
//                                          ni de suppression).
service cloud.firestore {
  match /databases/{database}/documents {
    function estAdmin(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /utilisateurs/{uid} {
      match /brouillon/{docId} {
        allow read, write: if estAdmin(uid) && docId == 'courant';
      }

      match /cycles/{cycleId} {
        allow read: if estAdmin(uid);
        allow create: if estAdmin(uid)
          && request.resource.data.id == cycleId
          && request.resource.data.version == 1
          && request.resource.data.resultat.ok == true;
        allow update, delete: if false;
      }
    }
  }
}
